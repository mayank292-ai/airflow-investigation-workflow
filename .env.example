OPENAI_API_KEY=
AFI_MODEL=gpt-5.4-mini
AFI_REASONING_EFFORT=low
AFI_MAX_MODEL_CALLS=8
AFI_MAX_TOOL_CALLS=24
AFI_MAX_OUTPUT_TOKENS=4000
AFI_CONTEXT_BYTES=100000
AFI_INVESTIGATION_SECONDS=180
# Conservative per-invocation admission budget, separate from provider billing.
AFI_MAX_USD=1.5
AFI_APPROVED_TOTAL_USD=3
# For the locally approved 120 KB context: AFI_CONTEXT_BYTES=120000,
# AFI_MAX_USD=1.8. This raises the reservation bound, not the $3 total approval.
AFI_AIRFLOW_URL=http://127.0.0.1:8080
AFI_AIRFLOW_USERNAME=airflow
AFI_AIRFLOW_PASSWORD=airflow
AFI_DAGS=local_pipeline_01,local_pipeline_02,local_pipeline_03
AFI_POLL_SECONDS=10
# Native Linux: set AIRFLOW_UID to the output of id -u for bind-mount ownership.
# Windows retains the Compose default of 50000. This is not a provider setting.
